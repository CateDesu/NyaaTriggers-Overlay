<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SourceRoot>../../NyaaTriggers.Plugin</SourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SourceRoot)/Configuration.cs" />
    <Compile Include="$(SourceRoot)/Plugin.cs" />
    <Compile Include="$(SourceRoot)/Bridge/*.cs" />
    <Compile Include="$(SourceRoot)/Meter/*.cs" />
    <Compile Include="$(SourceRoot)/Ui/DpsWindow.cs" />
    <Compile Include="$(SourceRoot)/Ui/OverlayWindow.cs" />
    <Compile Include="$(SourceRoot)/Ui/PluginUi.cs" />
    <Compile Include="$(SourceRoot)/Ui/JobColors.cs" />
    <Compile Include="$(SourceRoot)/Ui/AlertsWindow.cs" />
    <Compile Include="$(SourceRoot)/Ui/TimelineWindow.cs" />
    <Compile Include="$(SourceRoot)/Ui/FlashWindow.cs" />
    <Compile Include="$(SourceRoot)/Ui/ConfigWindow.cs" />
  </ItemGroup>
</Project>
