<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../NyaaTriggers.Plugin/Configuration.cs" Link="Configuration.cs" />
    <Compile Include="../../NyaaTriggers.Plugin/Bridge/*.cs" Link="Bridge/%(Filename)%(Extension)" />
    <Compile Include="../../NyaaTriggers.Plugin/Meter/*.cs" Link="Meter/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
