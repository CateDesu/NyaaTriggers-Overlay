<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <!-- Match the manifest InternalName so Dalamud finds the DLL. -->
    <AssemblyName>NyaaTriggers</AssemblyName>
    <RootNamespace>NyaaTriggers.Plugin</RootNamespace>
    <Version>0.2.0.0</Version>
    <Authors>CateDesu</Authors>
    <Company />
    <Description>Draws NyaaTriggers' timeline bars and alert callouts inside the game.</Description>
    <Copyright />
    <PackageProjectUrl>https://github.com/CateDesu/NyaaTriggers-Overlay</PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
