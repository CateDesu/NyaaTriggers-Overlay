<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <!-- Must equal InternalName in the manifest. Dalamud resolves an installed
         plugin as <InternalName>/<version>/<InternalName>.dll, so an assembly
         named after the project instead would simply never be found: the log
         says "No DLL found for plugin" and nothing loads. -->
    <AssemblyName>NyaaTriggers</AssemblyName>
    <RootNamespace>NyaaTriggers.Plugin</RootNamespace>
    <Version>0.1.0.0</Version>
    <Authors>CateDesu</Authors>
    <Company />
    <Description>Draws NyaaTriggers' timeline bars and alert callouts inside the game.</Description>
    <Copyright />
    <PackageProjectUrl>https://github.com/CateDesu/NyaaTriggers-Overlay</PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Warnings are errors: a Dalamud plugin that misbehaves takes the game
         down with it, so nothing sloppy gets to ship quietly. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
